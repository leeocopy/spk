{
  "name": "davidecarusio-clone",
  "version": "1.0.0",
  "description": "Full reverse-engineered clone of davidecarusio.it with complete frontend, backend API, animations, WebGL shader and offline assets",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:glyph": "esbuild components/glyph-hero-mount.tsx --bundle --format=iife --outfile=js/glyph-hero.js --jsx=automatic --target=es2020",
    "build:networking": "esbuild components/gravity-networking-mount.tsx --bundle --format=iife --outfile=js/gravity-networking.js --jsx=automatic --target=es2020",
    "build:flashlight": "esbuild components/flashlight-footer-mount.tsx --bundle --format=iife --outfile=js/flashlight-footer.js --jsx=automatic --target=es2020",
    "build:approach": "esbuild components/our-approach-mount.tsx --bundle --format=iife --outfile=js/our-approach.js --jsx=automatic --target=es2020"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "motion": "^14.12.0",
    "opentype.js": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tweakpane": "^4.0.5"
  },
  "keywords": [
    "portfolio",
    "webflow",
    "reverse-engineer",
    "gsap",
    "lenis",
    "unicornstudio"
  ],
  "author": "Antigravity Pair Programmer",
  "license": "ISC",
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
